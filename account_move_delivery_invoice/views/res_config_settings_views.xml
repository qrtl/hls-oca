<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_invoice_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='show_sale_receipts']" position="after">
                <setting
                    id="invoice_report_pdf_title"
                    company_dependent="1"
                    string="Invoice Report (PDF) Title"
                    help="If set, this value will be used as the title on the posted invoice report."
                >
                    <field name="invoice_report_pdf_title" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
