<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_form_banner_rule_tree" model="ir.ui.view">
        <field name="name">web.form.banner.rule.tree</field>
        <field name="model">web_form_banner.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="active"/>
                <field name="view_id"/>
                <field name="severity"/>
                <field name="field_name"/>
                <field name="invert"/>
                <field name="xpath"/>
                <field name="message"/>
            </tree>
        </field>
    </record>
  <record id="view_web_form_banner_rule_form" model="ir.ui.view">
      <field name="name">web.form.banner.rule.form</field>
      <field name="model">web_form_banner.rule</field>
      <field name="arch" type="xml">
          <form string="Form Banner Rule">
              <sheet>
                  <group>
                      <field name="active"/>
                      <field name="view_id" options="{'no_create': True}"/>
                      <field name="severity"/>
                      <field name="message"/>
                  </group>
                  <group string="Placement &amp; Condition" colspan="2">
                      <field name="xpath" placeholder="//sheet"/>
                      <field name="field_name" placeholder="x_show_warning"/>
                      <field name="invert"/>
                  </group>
              </sheet>
          </form>
      </field>
  </record>
  <record id="action_web_form_banner_rule" model="ir.actions.act_window">
      <field name="name">Form Banner Rules</field>
      <field name="res_model">web_form_banner.rule</field>
      <field name="view_mode">tree,form</field>
  </record>
  <menuitem id="menu_web_form_banner_root" name="Form Banners" sequence="80"/>
  <menuitem id="menu_web_form_banner_rules" name="Rules"
            parent="menu_web_form_banner_root" action="action_web_form_banner_rule"/>
</odoo>
